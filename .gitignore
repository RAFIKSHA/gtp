# =============================================================================
# CodexPetra GATE Portal — Production .gitignore
# Covers Next.js Frontend + Django DRF Backend + Hosting (Vercel/Railway/Render)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL FOR HOSTING)
# -----------------------------------------------------------------------------
.env
.env*
!.env.example
backend/.env
backend/.env*
!backend/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# -----------------------------------------------------------------------------
# 2. Next.js & Frontend Node Dependencies
# -----------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build/
/dist/

# Next.js / TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Vercel / Turbopack
.vercel/
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 3. Python & Django Backend
# -----------------------------------------------------------------------------
# Virtual Environments
backend/.venv/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Databases (Local SQLite should never be committed)
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Django Static & Media uploads (served by cloud/CDN in hosting)
backend/staticfiles/
staticfiles/
backend/media/
media/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# 4. Operating System & Editor Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Linux
*~

# IDEs & Code Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# 5. Temporary, Logs & Scratch
# -----------------------------------------------------------------------------
*.log
scratch/
tmp/
temp/
